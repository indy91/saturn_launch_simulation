                                                   *                                                                    *
                                                   *      POWER UP AND INITIALIZE ROUTINE                               *J
                                                   *                                                                    *
                                                   *                                                                    *
                                                   **********************************************************************
                                                   * FUNCTION   THIS ROUTINE PERFORMS THE NECESSARY INITIALIZATION AFTER
                                                   *            POWER HAS BEEN APPLIED TO THE LVDA AND LVDC. THE ROUTINE
                                                   *            IS AUTOMATICALLY ENTERED UPON THE RELEASE OF THE HALT
                                                   *            SIGNAL.
                                                   * ENTRIES    START    LOCATED AT 0-00-0-000 AND ENTERED UPON RELEASE
                                                   *                     OF THE HALT SIGNAL.
                                                          ORG     0,0,0,000,0,0,0
     0 00 0 000  0 00    034  1  03    000000002   START  DIV     =1           DIVIDE TO INHIBIT INTERRUPTS              B
     0 00 0 001  0 00    077  0  17                       CLA     OBFLAG       DID PROGRAM COME FROM ORBITAL FLIGHT      Q
     0 00 0 002  0 00    004  0  04                       TNZ     *+2                                                    Y
     0 00 0 003  0 00    015  0  10                       TRA     INIT                                                   N
     0 00 0 004  0 00    057  0  12                       PIO     057          IS RCA-110 SYNC PRESENT?                  Q
     0 00 0 005  0 00    032  1  06                       AND     D.KB23
     0 00 0 006  0 00    010  0  04                       TNZ     *+2
     0 00 0 007  0 00    007  0  10                EXIT   TRA     *            ABORT RUN                                 B
     0 00 0 010  0 00    043  0  12                       PIO     043          READ RCA-100 COMMAND                      Y
     0 00 0 011  0 00    061  0  06    777760000          AND     =O77776
     0 00 0 012  0 00    034  1  03    000000002          DIV     =1           DIVIDE TO INHIBIT INTERRUPTS              B
     0 00 0 013  0 00    003  1  11                       XOR     D.KBSG
     0 00 0 014  0 00    007  0  04                       TNZ     EXIT
     0 00 0 015  0 00    062  0  17    377740000   INIT   CLA     =O37774
     0 00 0 016  0 00    032  0  12                       PIO     032          RESET ALL INITIAL INTERRUPTS              I
     0 00 0 017  0 00    062  0  17    377740000          CLA     =O37774
     0 00 0 020  0 00    072  0  12                       PIO     072          INHIBIT ALL INITIAL INTERRUPTS            I
     0 00 0 021  0 00    034  1  17                       CLA     D.KB25
     0 00 0 022  0 00    022  0  12                       PIO     022          PLACE DOM UNDER G-SYNC CONTROL            I
     0 00 0 023  0 00    066  0  12                       PIO     066          PLACE THE COD ERROR WORD IN THE DOM       I
     0 00 0 024  0 00    077  0  17                       CLA     OBFLAG       IS THE PROGRAM FROM ORBITAL FLIGHT        Q
     0 00 0 025  0 00    027  0  04                       TNZ     MEMOK                                                  Y
     0 00 0 026  0 00    375  1  17                       CLA     775          FIXME: RESTORE MEMORY TEST LOCATIONS
     0 00 0 027  0 00    063  0  17    357740000   MEMOK  CLA     =O35774
     0 00 0 030  0 00    072  0  12                       PIO     072          INHIBIT ALL INTERRUPTS EXCEPT TLC         I
     0 00 0 031  0 00    057  0  12                       PIO     057          IS RCA-110 SYNC PRESENT
     0 00 0 032  0 00    032  1  06                       AND     D.KB23
     0 00 0 033  0 00    035  0  04                       TNZ     *+2
     0 00 0 034  0 00    043  0  10                       TRA     NORMPF
     0 00 0 035  0 00    043  0  12                       PIO     043          IS SPECIAL LOADER COMMANDED               Q
     0 00 0 036  0 00    061  0  06    777760000          AND     =O77776
     0 00 0 037  0 00    003  1  11                       XOR     D.KBSG
     0 00 0 040  0 00    043  0  04                       TNZ     NORMPF                                                 N
     0 00 0 041  0 00    064  0  00                       HOP*    RINIT        REGISTER INITIALIZE                       P
