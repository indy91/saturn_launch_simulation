     0 01 0 012  0 03    022  0  12                       PIO     022          SET ICR'S 1 + 9, RESET ALL ICR'S EXCEPT   B
     0 01 0 013  0 03    037  1  11                       XOR     D.KONS       1 AND 9                                   B
     0 01 0 014  0 03    026  0  12                       PIO     026
     0 01 0 015  0 03    074  0  17    265252260          CLA     =O265252260
     0 01 0 016  0 03    075  0  00                       HOP*    ISS          ISSUE STATUS CODE                         P
     0 01 0 017  0 03    066  0  00                       HOP*    RINIT        REGISTER INITIALIZE                       P
     0 01 0 020  0 03    002  1  17                       CLA     EMCON1       INITIALIZE EMCON = EMCON1                 B
     0 01 0 021  0 03    003  0  13                       STO     EMCON
     0 01 0 022  0 03    002  0  17                       CLA     GCOTST       IS GCO TEST ON                            Q
     0 01 0 023  0 03    036  0  04                       TNZ     FBR4                                                   Y
     0 01 0 024  0 03    203  0  12                       PIO     203          STOP COD COUNTERS WITH A DUMMY GROUP 5 PIOI
     0 01 0 025  0 03    301  1  17                       CLA     V.EMR
     0 01 0 026  0 03    003  0  06                       AND     EMCON        IS SAVED EMR (MASKED) EQUAL ERROR         Q
     0 01 0 027  0 03    031  0  04                       TNZ     *+2                                                    Y
     0 01 0 030  0 03    041  0  10                       TRA     FBR5                                                   N
     0 01 0 031  0 03    076  0  17    512525510          CLA     =O512525510
     0 01 0 032  0 03    075  0  00                       HOP*    ISS          ISSUE STATUS CODE 51                      P
     0 01 0 033  0 03    301  1  12                       PIO     701          TELEMETER EMR CONTENTS                    I
     0 01 0 034  0 03    077  0  00                       HOP*    OIGS         GENERATE OUTPUT INT.                      P
     0 01 0 035  0 03    037  0  10                       TRA     *+2
     0 01 0 036  0 03    041  0  14                FBR4   TMI     FBR5         IS GCO TEST LOCATION MINUS                Q
     0 01 0 037  0 03    076  0  17    512525510          CLA     =O512525510                                            N
