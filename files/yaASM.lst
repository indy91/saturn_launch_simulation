     0 00 0 051  0 03    067  0  00                       HOP*    KIN400       HOP 400 INITIALIZE
     0 00 0 052  0 03    023  0  12                       PIO     023          DUMMY EMR READ                            I
     0 00 0 053  0 03    070  0  17    357540000          CLA     =O35754
