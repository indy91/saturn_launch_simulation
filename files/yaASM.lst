     0 01 0 041  0 03    057  0  12                FBR5   PIO     057
     0 01 0 042  0 03    032  1  06                       AND     D.KB23       IS SYNC ON                                Q
     0 01 0 043  0 03    045  0  04                       TNZ     *+2                                                    Y
